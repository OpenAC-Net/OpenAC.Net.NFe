<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net462;net48;netstandard2.0;net8.0;net9.0;net10.0</TargetFrameworks>
        <AssemblyName>OpenAC.Net.NFe.DANFe.PDFSharp</AssemblyName>
        <RootNamespace>OpenAC.Net.NFe.DANFe.PDFSharp</RootNamespace>
        <SignAssembly>true</SignAssembly>
        <Description>Biblioteca para geração e impressão de DANFE (Documento Auxiliar da NF-e e NFC-e) em PDF usando PDFsharp.</Description>
        <PackageTags>OpenAC.Net NFe NFCe OpenNFe DANFE PDFSharp</PackageTags>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../OpenAC.Net.NFe/OpenAC.Net.NFe.csproj"/>
        <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14"/>
        <PackageReference Include="PDFsharp" Version="6.2.4"/>
        <PackageReference Include="QRCoder" Version="1.8.1"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Resources/Fonts/*.ttf"/>
        <None Include="Resources/Fonts/LICENSE.txt" Pack="true" PackagePath="licenses/"/>
        <None Include="README.md" Pack="true" PackagePath="/"/>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net462'">
        <PackageReference Include="System.ValueTuple" Version="4.6.2"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="../Shared/Printing/NFeImpressao.cs" Link="Common/NFeImpressao.cs"/>
    </ItemGroup>
</Project>
