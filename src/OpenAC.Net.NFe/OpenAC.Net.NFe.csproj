<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net462;net48;netstandard2.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>OpenAC.snk</AssemblyOriginatorKeyFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <Description>NF-e e NFC-e: modelos 3.10 e 4.00, assinatura, validação e serviços SEFAZ.</Description>
  </PropertyGroup>
  <ItemGroup Condition="'$(DFeCoreProject)' == ''">
    <PackageReference Include="OpenAC.Net.DFe.Core" Version="1.8.0-beta.5" />
  </ItemGroup>
  <ItemGroup Condition="'$(DFeCoreProject)' != ''">
    <ProjectReference Include="$(DFeCoreProject)" />
    <ProjectReference Include="$([System.IO.Path]::GetDirectoryName('$(DFeCoreProject)'))/../OpenAC.Net.DFe.Generator/OpenAC.Net.DFe.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net462' or '$(TargetFramework)' == 'net48'">
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Schemas/**/*.xsd" CopyToOutputDirectory="PreserveNewest" PackageCopyToOutput="true" Pack="true" PackagePath="contentFiles/any/any/Schemas/" />
    <EmbeddedResource Include="Resources/services.xml" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
