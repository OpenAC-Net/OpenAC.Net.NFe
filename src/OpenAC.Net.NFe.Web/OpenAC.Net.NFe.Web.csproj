<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net462;net48;netstandard2.0;net8.0;net9.0;net10.0</TargetFrameworks>
        <AssemblyName>OpenAC.Net.NFe.Web</AssemblyName>
        <RootNamespace>OpenAC.Net.NFe.Web</RootNamespace>
        <SignAssembly>true</SignAssembly>
        <Description>Integração da OpenAC.Net.NFe com injeção de dependência, transporte HTTP e serviços do ASP.NET Core.</Description>
        <PackageTags>OpenAC.Net NFe NFCe OpenNFe ASP.NET Core Web DI Multiempresa</PackageTags>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../OpenAC.Net.NFe/OpenAC.Net.NFe.csproj"/>
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14"/>
        <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/"/>
    </ItemGroup>
</Project>
