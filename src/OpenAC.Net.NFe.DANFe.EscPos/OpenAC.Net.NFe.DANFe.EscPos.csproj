<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net462;net48;netstandard2.0;net8.0;net9.0;net10.0</TargetFrameworks>
        <AssemblyName>OpenAC.Net.NFe.DANFe.EscPos</AssemblyName>
        <RootNamespace>OpenAC.Net.NFe.DANFe.EscPos</RootNamespace>
        <SignAssembly>true</SignAssembly>
        <Description>Biblioteca para geração e impressão de DANFE NFC-e em impressoras térmicas usando ESC/POS.</Description>
        <PackageTags>OpenAC.Net NFe NFCe OpenNFe DANFE EscPos</PackageTags>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../OpenAC.Net.NFe/OpenAC.Net.NFe.csproj" />
        <None Include="README.md" Pack="true" PackagePath="/" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="OpenAC.Net.EscPos" Version="1.7.0" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="../Shared/Printing/NFeImpressao.cs" Link="Common/NFeImpressao.cs" />
    </ItemGroup>
</Project>
